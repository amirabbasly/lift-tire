# ─────────────── لیفت تایر — نمونه متغیرهای محیطی ───────────────
# این فایل را به .env کپی کنید و مقادیر را تغییر دهید.

# ── پایگاه داده ───────────────────────────────────────────────
# در پروداکشن (داکر) از PostgreSQL استفاده می‌شود:
DATABASE_URL=postgresql://lifttire:CHANGE_ME_DB_PASSWORD@postgres:5432/lifttire
# در محیط توسعه می‌توانید PGlite را فعال کنید (بدون نیاز به Postgres):
USE_PGLITE=false
# مسیر داده PGlite (فقط حالت توسعه)
PGDATA=./data/pglite

# ── امنیت ────────────────────────────────────────────────────
# حتماً یک رشته تصادفی و طولانی بگذارید: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── مدیر پیش‌فرض (در seed استفاده می‌شود) ─────────────────────
ADMIN_EMAIL=admin@lifttire.ir
ADMIN_PASSWORD=Lift@12345

# ── آپلود ────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── فرانت‌اند ────────────────────────────────────────────────
# خالی بگذارید تا درخواست‌ها هم‌مبدأ (از طریق nginx یا rewrite نکست) ارسال شوند
NEXT_PUBLIC_API_BASE=
# آدرس داخلی API برای رندر سمت سرور
API_INTERNAL_URL=http://api:4000

# ── پورت‌ها ──────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000

# ── پستگرس (docker-compose) ──────────────────────────────────
POSTGRES_DB=lifttire
POSTGRES_USER=lifttire
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
