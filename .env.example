# ─────────────── لیفت تایر — نمونه متغیرهای محیطی ───────────────
# این فایل را به .env کپی کنید و مقادیر را تغییر دهید:  cp .env.example .env
#
# دو روش اجرا (هر دو از همین .env می‌خوانند):
#   الف) داکر (توصیه‌شده):  ./deploy.sh up      ← همه‌چیز با یک دستور روی HTTP
#   ب)  PM2:                sudo ./scripts/deploy-pm2.sh install

# ── دامنه و آدرس سایت ─────────────────────────────────────────
DOMAIN=lift-tire.com
NEXT_PUBLIC_SITE_URL=https://lift-tire.com

# ── امنیت ────────────────────────────────────────────────────
# حتماً یک رشته تصادفی و طولانی بگذارید: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── مدیر پیش‌فرض (در seed استفاده می‌شود) ─────────────────────
ADMIN_EMAIL=admin@lift-tire.com
ADMIN_PASSWORD=Lift@12345

# ── دیتابیس ──────────────────────────────────────────────────
# USE_PGLITE=true  → فایل محلی، بدون هیچ سرور دیتابیس (ساده‌ترین حالت، پیشنهادی برای PM2)
# USE_PGLITE=false → PostgreSQL  (در داکر: host=postgres  |  در PM2: host=127.0.0.1)
USE_PGLITE=true
PGDATA=./backend/data/pglite
DATABASE_URL=postgresql://lifttire:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/lifttire
# داخل داکر این مقدار را به postgres:5432 تغییر دهید (compose خودش این کار را می‌کند)

# ── Postgres (docker compose) ────────────────────────────────
POSTGRES_DB=lifttire
POSTGRES_USER=lifttire
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── آپلود ────────────────────────────────────────────────────
# PM2: ./backend/uploads   |   داکر: /app/uploads (compose خودش override می‌کند)
UPLOAD_DIR=./backend/uploads

# ── شبکه فرانت/بک ────────────────────────────────────────────
# خالی بگذارید تا درخواست‌ها هم‌مبدأ (از طریق nginx) ارسال شوند
NEXT_PUBLIC_API_BASE=
# آدرس داخلی API برای رندر سمت سرور
# PM2: http://127.0.0.1:4000   |   داکر: http://api:4000
API_INTERNAL_URL=http://127.0.0.1:4000

# ── پورت‌ها ──────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000
# آدرس شنود api/web:
#   127.0.0.1 → پیش‌فرض امن روی سرور (فقط nginx دسترسی دارد)
#   0.0.0.0   → فقط برای پیش‌نمایش/سندباکس یا وقتی مستقیماً به اینترنت وصل می‌شوید
BIND_HOST=127.0.0.1

# ── گواهی SSL (certbot نصبی روی سرور — نه داکر، نه Cloudflare) ──
# این‌ها مسیرهای خودِ سرور هستند و به کانتینر nginx مانت می‌شوند
LETSENCRYPT_DIR=/etc/letsencrypt
ACME_WEBROOT=/var/www/certbot

# ── حالت nginx ───────────────────────────────────────────────
# auto : با وجود گواهی → HTTPS، بدون گواهی → HTTP (پیشنهادی)
# http : همیشه HTTP حتی اگر گواهی موجود باشد
# https: همیشه HTTPS (اگر گواهی نباشد خودکار به HTTP برمی‌گردد)
NGINX_MODE=auto

# هیچ API Token یا دسترسی Zone لازم نیست.
# گواهی با certbot نصبی و روش webroot گرفته می‌شود:
#   ./deploy.sh up            → سایت روی HTTP
#   sudo ./scripts/ssl-certbot.sh   → گواهی + سوییچ خودکار به HTTPS
