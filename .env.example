# ─────────────── لیفت تایر — نمونه متغیرهای محیطی ───────────────
# این فایل را به .env کپی کنید و مقادیر را تغییر دهید:  cp .env.example .env

# ── دامنه و آدرس سایت ─────────────────────────────────────────
DOMAIN=lift-tire.com
NEXT_PUBLIC_SITE_URL=https://lift-tire.com

# ── امنیت ────────────────────────────────────────────────────
# حتماً یک رشته تصادفی و طولانی بگذارید: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── مدیر پیش‌فرض (در seed استفاده می‌شود) ─────────────────────
ADMIN_EMAIL=admin@lift-tire.com
ADMIN_PASSWORD=Lift@12345

# ── دیتابیس ──────────────────────────────────────────────────
# در پروداکشن (داکر) از PostgreSQL استفاده می‌شود:
DATABASE_URL=postgresql://lifttire:CHANGE_ME_DB_PASSWORD@postgres:5432/lifttire
# محیط توسعه بدون Postgres (PGlite):
USE_PGLITE=false
PGDATA=./data/pglite

# ── Postgres (docker compose) ────────────────────────────────
POSTGRES_DB=lifttire
POSTGRES_USER=lifttire
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── آپلود ────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads

# ── شبکه فرانت/بک ────────────────────────────────────────────
# خالی بگذارید تا درخواست‌ها هم‌مبدأ (از طریق nginx) ارسال شوند
NEXT_PUBLIC_API_BASE=
# آدرس داخلی API برای رندر سمت سرور
API_INTERNAL_URL=http://api:4000

# ── پورت‌ها (فقط روی 127.0.0.1 باز می‌شوند) ─────────────────
API_PORT=4000
WEB_PORT=3000

# ── Cloudflare (اختیاری) ─────────────────────────────────────
# اگر دامنه پشت Cloudflare است، برای گرفتن گواهی با DNS-01:
#   My Profile → API Tokens → Create Token → Edit zone DNS
#   Permissions: Zone → DNS → Edit   |   Zone Resources: lift-tire.com
CLOUDFLARE_API_TOKEN=
